# Cargo
target/
**/*.rs.bk
*.pdb

# pixi environments
.pixi/*
!.pixi/config.toml

# Images and layouts a local run writes
/*.tar
/oci-layout/
# and those the examples' config files write beside them
/examples/projects/pixi/*/*.tar
# Images pulled locally to try out, kept out of the repository
/examples/local-registry/

# Local Claude overrides and worktrees
CLAUDE.local.md
.claude/worktrees/

# Environment files
.env
.env.*

# The documentation site, built by `pixi run -e docs docs-build`
/site/

# Python bytecode from mkdocs_hooks.py
__pycache__/
